<interface domain="ddterm@amezin.github.com">
  <requires lib="gtk" version="4.0"/>

  <template class="DDTermAppWindow" parent="GtkApplicationWindow">
    <property name="name">ddterm-window</property>
    <property name="overflow">hidden</property>
    <signal name="notify::is-split" handler="_notify_split_layout"/>
    <signal name="notify::split-orientation" handler="_emit_session_update"/>
    <child>
      <object class="GtkGrid" id="layout">
        <property name="visible">True</property>
        <child>
          <object class="GtkGrid" id="workarea_container">
            <property name="visible">True</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkPaned" id="paned">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="wide-handle">True</property>
                <property name="resize-start-child">True</property>
                <property name="shrink-start-child">False</property>
                <property name="resize-end-child">True</property>
                <property name="shrink-end-child">False</property>
                <signal name="notify::orientation" handler="_notify_split_layout"/>
                <child>
                  <object class="DDTermNotebook" id="notebook1">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="split-layout" bind-source="DDTermAppWindow" bind-property="split-layout" bind-flags="sync-create"/>
                    <signal name="notify::visible" handler="_notebook_notify_visible"/>
                    <signal name="notify::n-pages" handler="_notebook_notify_n_pages"/>
                    <signal name="split-layout" handler="_notebook_split_layout"/>
                    <signal name="move-to-other-pane" handler="_notebook_transfer_page"/>
                    <signal name="session-update" handler="_emit_session_update"/>
                  </object>
                </child>
                <child>
                  <object class="DDTermNotebook" id="notebook2">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="split-layout" bind-source="DDTermAppWindow" bind-property="split-layout" bind-flags="sync-create"/>
                    <signal name="notify::visible" handler="_notebook_notify_visible"/>
                    <signal name="notify::n-pages" handler="_notebook_notify_n_pages"/>
                    <signal name="split-layout" handler="_notebook_split_layout"/>
                    <signal name="move-to-other-pane" handler="_notebook_transfer_page"/>
                    <signal name="session-update" handler="_emit_session_update"/>
                  </object>
                </child>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="resize_box_north">
                <property name="visible">True</property>
                <style>
                  <class name="background"/>
                </style>
                <child>
                  <object class="GtkSeparator">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="margin-top">2</property>
                    <property name="margin-bottom">2</property>
                  </object>
                </child>
                <layout>
                  <property name="column">1</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="resize_box_south">
                <property name="visible">True</property>
                <style>
                  <class name="background"/>
                </style>
                <child>
                  <object class="GtkSeparator">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="margin-top">2</property>
                    <property name="margin-bottom">2</property>
                  </object>
                </child>
                <layout>
                  <property name="column">1</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="resize_box_west">
                <property name="visible">True</property>
                <style>
                  <class name="background"/>
                </style>
                <child>
                  <object class="GtkSeparator">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="margin-start">2</property>
                    <property name="margin-end">2</property>
                  </object>
                </child>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="resize_box_east">
                <property name="visible">True</property>
                <style>
                  <class name="background"/>
                </style>
                <child>
                  <object class="GtkSeparator">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="margin-start">2</property>
                    <property name="margin-end">2</property>
                  </object>
                </child>
                <layout>
                  <property name="column">2</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <layout>
              <property name="column">1</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="DDTermSpacer" id="spacer_north">
            <property name="visible">True</property>
            <property name="opacity" bind-source="DDTermAppWindow" bind-property="background-opacity" bind-flags="sync-create"/>
            <style>
              <class name="background"/>
            </style>
            <layout>
              <property name="column">1</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="DDTermSpacer" id="spacer_south">
            <property name="visible">True</property>
            <property name="opacity" bind-source="DDTermAppWindow" bind-property="background-opacity" bind-flags="sync-create"/>
            <style>
              <class name="background"/>
            </style>
            <layout>
              <property name="column">1</property>
              <property name="row">2</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="DDTermSpacer" id="spacer_west">
            <property name="visible">True</property>
            <property name="opacity" bind-source="DDTermAppWindow" bind-property="background-opacity" bind-flags="sync-create"/>
            <style>
              <class name="background"/>
            </style>
            <layout>
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="DDTermSpacer" id="spacer_east">
            <property name="visible">True</property>
            <property name="opacity" bind-source="DDTermAppWindow" bind-property="background-opacity" bind-flags="sync-create"/>
            <style>
              <class name="background"/>
            </style>
            <layout>
              <property name="column">2</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </template>

</interface>
